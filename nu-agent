#!/usr/bin/env nu
use ./mod.nu *

export def main [
  --prompt: string = ""
  --contract: string = ""
] {
  if $prompt == "" {
    error make { msg: "Missing required --prompt argument. Usage: nu-agent --prompt <prompt> [--contract <path>]" }
  }
  let contract_path = if $contract != "" {
    $contract
  } else {
    (get-config).engine.default_contract
  }
  run $contract_path $prompt
}
